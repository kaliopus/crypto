# Copy to .env and fill in. Never commit the real .env.

# Random long string you invent yourself — this is the API key your
# laptop will use to authenticate to your own vLLM server.
VLLM_API_KEY=

# Hugging Face token with access to the Llama license (needed to pull
# gated weights the first time the container starts).
HF_TOKEN=

# Which model to serve. Swap freely — anything vLLM + AWQ/GPTQ supports
# fits on a single 80GB H100 at 70B-class size:
#   hugging-quants/Meta-Llama-3.1-70B-Instruct-AWQ-INT4   (default)
#   Qwen/Qwen2.5-72B-Instruct-AWQ
#   casperhansen/deepseek-r1-distill-llama-70b-awq
MODEL_ID=hugging-quants/Meta-Llama-3.1-70B-Instruct-AWQ-INT4

MAX_MODEL_LEN=16384
